; Canonical Cat Paw gameplay-actor export project.

config_version=5

[application]
config/name="Cat Paw Gameplay Actors"
run/main_scene="res://paw.tscn"

[display]
window/size/viewport_width=112
window/size/viewport_height=112
window/size/window_width_override=112
window/size/window_height_override=112

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
